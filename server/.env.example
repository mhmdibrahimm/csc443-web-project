# Supabase Postgres connection string. Get it from
# Supabase project settings -> Database -> Connection string -> URI.
# Use the "Session" pooler URL for long-lived servers.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# 32+ random bytes. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-long-random-string

# How long an issued JWT is valid. Accepts ms-style durations (e.g. "7d", "12h").
JWT_EXPIRES_IN=7d

# HTTP port the API listens on.
PORT=3001

# Frontend origin allowed by CORS. Comma-separate multiple origins.
CORS_ORIGIN=http://localhost:5173
